ARG SOURCE_REVISION=unknown
ARG NODE_VERSION=24.22.2
FROM mcr.microsoft.com/playwright:v1.64.1-resolute@sha256:f76885029244e5a384243a930ff283cef67d90653978ee27a77dd4cff8882fb4 AS dependencies
ARG NODE_VERSION
ADD --checksum=sha256:361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9 \
    https://nodejs.org/dist/v24.22.2/node-v24.22.2-linux-x64.tar.gz /tmp/node-v24.22.2-linux-x64.tar.gz
RUN tar -xzf /tmp/node-v24.22.2-linux-x64.tar.gz -C /opt \
    && test -s /opt/node-v24.22.2-linux-x64/LICENSE \
    && rm -f /tmp/node-v24.22.2-linux-x64.tar.gz
ENV PATH="/opt/node-v24.22.2-linux-x64/bin:${PATH}"
WORKDIR /opt/browser
COPY package.json package-lock.json ./
RUN node --version | grep -Fx "v${NODE_VERSION}" \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM mcr.microsoft.com/playwright:v1.64.1-resolute@sha256:f76885029244e5a384243a930ff283cef67d90653978ee27a77dd4cff8882fb4 AS worker
ARG SOURCE_REVISION
ARG NODE_VERSION
LABEL org.opencontainers.image.title="404404 AI-Bots standalone browser service comparison" \
      org.opencontainers.image.source="https://github.com/404404/AI-Bots" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.base.name="mcr.microsoft.com/playwright:v1.64.1-resolute" \
      org.opencontainers.image.base.digest="sha256:f76885029244e5a384243a930ff283cef67d90653978ee27a77dd4cff8882fb4" \
      io.404404.runtime.node.version="24.22.2" \
      io.404404.runtime.node.source="https://nodejs.org/dist/v24.22.2/node-v24.22.2-linux-x64.tar.gz" \
      io.404404.runtime.node.sha256="361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9" \
      io.404404.runtime.node.license="MIT" \
      io.404404.scan.node-core.coverage="uncovered" \
      io.404404.scan.node-core.reason="Trivy image scan does not establish coverage of the official Node binary" \
      io.404404.role="worker"
# Keep the image's Ubuntu shared libraries. Install only the official Node executable and license;
# npm is needed in the dependency stage but is not part of the runtime image.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get purge -y nodejs \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dependencies /opt/node-v24.22.2-linux-x64/bin/node /opt/node-v24/bin/node
COPY --from=dependencies /opt/node-v24.22.2-linux-x64/LICENSE /usr/share/doc/nodejs/LICENSE
ENV PATH="/opt/node-v24/bin:${PATH}" \
    NODE_ENV=production HOME=/tmp BROWSER_DATA_ROOT=/tmp/browser-sessions
WORKDIR /opt/browser
COPY package.json package-lock.json ./
COPY LICENSE NOTICE.md ./
COPY --from=dependencies --chown=10001:10001 /opt/browser/node_modules ./node_modules
RUN node --version | grep -Fx "v${NODE_VERSION}" \
    && mkdir -p /run/browser-control /run/browser-egress /tmp/browser-sessions \
    && chown -R 10001:10001 /opt/browser /run/browser-control /run/browser-egress /tmp/browser-sessions
COPY src ./src
COPY fixture ./fixture
COPY scripts ./scripts
USER 10001:10001
ENV BROWSER_CONTROL_SOCKET=/run/browser-control/worker.sock \
    BROWSER_PROXY_SOCKET=/run/browser-egress/proxy.sock \
    BROWSER_PROXY_ADMIN_SOCKET=/run/browser-egress/admin.sock
CMD ["node", "src/worker.mjs"]
