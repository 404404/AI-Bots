{
  "expo": {
    "name": "DeepSeekBot Dev",
    "slug": "deepseekbot",
    "scheme": ["deepseekbot-dev", "deepseekbot"],
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.botharness.deepseekbot.dev",
      "supportsTablet": false
    },
    "android": {
      "package": "ai.botharness.deepseekbot.dev"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "DeepSeekBot uses the camera to scan the pairing code shown on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
