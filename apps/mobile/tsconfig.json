{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "app",
    "src",
    "test/posthog-sender.test.ts",
    "test/native-telemetry.test.ts",
    "test/native-persistence.test.ts",
    "test/inbox-screens.test.ts",
    "test/action-cards.test.ts",
    "test/activity-feed.test.ts",
    "test/reanimated-shim.ts",
    "test/**/*.tsx"
  ]
}
