{
  "expo": {
    "name": "DeepSeekBot Dev",
    "slug": "deepseekbot",
    "scheme": ["deepseekbot-dev", "deepseekbot", "ai.botharness.deepseekbot.dev"],
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json"
    },
    "ios": {
      "bundleIdentifier": "ai.botharness.deepseekbot.dev",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en", "zh-Hans"]
      }
    },
    "android": {
      "package": "ai.botharness.deepseekbot.dev"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "DeepSeekBot uses the camera to scan the pairing code shown on your computer and to take photos you send to a PersonaBot.",
          "microphonePermission": "DeepSeekBot uses the microphone to turn what you say into a message you can edit before sending to a PersonaBot.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DeepSeekBot opens your photos so you can send them to a PersonaBot.",
          "cameraPermission": "DeepSeekBot uses the camera to scan the pairing code shown on your computer and to take photos you send to a PersonaBot.",
          "microphonePermission": "DeepSeekBot uses the microphone to turn what you say into a message you can edit before sending to a PersonaBot."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DeepSeekBot uses the microphone to turn what you say into a message you can edit before sending to a PersonaBot.",
          "speechRecognitionPermission": "DeepSeekBot turns what you say into text so you can send it to a PersonaBot. You see and edit the text before it is sent."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "DeepSeekBot",
            "ios": {
              "light": "./assets/app-icons/deepseekbot-light.png",
              "dark": "./assets/app-icons/deepseekbot-dark.png",
              "tinted": "./assets/app-icons/deepseekbot-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/app-icons/deepseekbot-android-foreground.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "DeepSeekBotSimple",
            "ios": {
              "light": "./assets/app-icons/deepseekbot-simple-light.png",
              "dark": "./assets/app-icons/deepseekbot-simple-dark.png",
              "tinted": "./assets/app-icons/deepseekbot-simple-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/app-icons/deepseekbot-simple-android-foreground.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        ]
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "web": {
      "output": "single"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
