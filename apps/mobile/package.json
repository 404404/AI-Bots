{
  "name": "@botharness/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeekBot mobile app: a native Expo client for the Human's paired Host",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist-web",
    "eas:dev": "eas build --profile development",
    "expo:doctor": "expo-doctor",
    "e2e:ios": "maestro test --platform ios .maestro",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:palette": "node scripts/generate-palette.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "expo": "57.0.30",
    "expo-alternate-app-icons": "8.0.0",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-speech-recognition": "~57.1.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "posthog-react-native": "4.81.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "remend": "1.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.3",
    "expo-doctor": "1.20.4"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  }
}
