{
  "name": "@botharness/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeekBot mobile app: a native Expo client for the Human's paired Host",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist-web",
    "eas:dev": "eas build --profile development",
    "expo:doctor": "expo-doctor",
    "e2e:ios": "maestro test --platform ios .maestro",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:palette": "node scripts/generate-palette.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.20",
    "@tanstack/react-query": "^5.104.3",
    "entities": "^8.1.0",
    "expo": "58.0.14",
    "expo-alternate-app-icons": "8.0.0",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-speech-recognition": "~58.0.0",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "marked": "^18.1.1",
    "posthog-react-native": "4.81.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tab-view": "^4.3.4",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "remend": "1.4.0",
    "unicode-segmenter": "^0.17.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.7",
    "expo-doctor": "1.21.4"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  }
}
