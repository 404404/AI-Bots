# Replace with the exact ghcr.io/404404/ai-bots@sha256:<published digest>.
IMAGE_REF=ghcr.io/404404/ai-bots@sha256:replace-with-published-digest

# Use the image's named dsh account (also used in CI); D-Bus requires it.
# Give only ./data to 10001:10001. Do not substitute the host login UID.
PUID=10001
PGID=10001

# Only publish on loopback. Reach it remotely through SSH local forwarding.
HOST_PORT=20443
PUBLIC_URL=http://127.0.0.1:20443
WORKSPACE_ID=deepseekbot-gui
CODEX_CALLBACK_PORT=1455
