{
  "name": "deepseekbot",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeekBot bundle: BotHarness core + web client, installed as one profile layer",
  "bin": {
    "botharness-profile": "./dist/profile-cli.mjs",
    "deepseekbot": "./dist/deepseekbot.mjs",
    "deepseekbot-zoom-setup": "./dist/desktop-zoom-setup.mjs"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "desktop-theme"
  ],
  "type": "module",
  "dependencies": {
    "@botharness/browser": "link:../browser",
    "@botharness/computer": "link:../computer",
    "@botharness/core": "link:../core",
    "@botharness/ui": "link:../client",
    "dsh-codex-oauth": "github:callqh/dsh-codex-oauth#3f4fdec20ab4d1e93fa60954f6687c3d01bb4241"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
