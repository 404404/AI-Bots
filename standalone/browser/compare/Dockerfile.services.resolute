ARG SOURCE_REVISION=unknown
ARG PACKAGE_LOCK_SHA256=unknown
ARG NODE_VERSION=24.22.2

# Docker Official Image, Ubuntu Resolute, linux/amd64 OCI index pinned in serviceScenarios.
FROM ubuntu:resolute@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c AS runtime-base
ARG SOURCE_REVISION
ARG PACKAGE_LOCK_SHA256
ARG NODE_VERSION
ENV DEBIAN_FRONTEND=noninteractive
LABEL org.opencontainers.image.title="404404 standalone browser service comparison" \
      org.opencontainers.image.source="https://github.com/404404/AI-Bots" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.base.name="ubuntu:resolute" \
      org.opencontainers.image.base.digest="sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c" \
      org.opencontainers.image.base.platform.manifest.digest="sha256:157dc3d6e4a3e4f2c68d12df9df9ed6e808b59af6d4c3757b432b4f519916725" \
      io.404404.platform="linux/amd64" \
      io.404404.runtime.node.version="${NODE_VERSION}" \
      io.404404.runtime.node.source="https://nodejs.org/dist/v24.22.2/node-v24.22.2-linux-x64.tar.gz" \
      io.404404.runtime.node.sha256="361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9" \
      io.404404.runtime.node.license="MIT" \
      io.404404.package-lock.sha256="${PACKAGE_LOCK_SHA256}" \
      io.404404.scan.node-core.coverage="uncovered" \
      io.404404.scan.node-core.reason="Trivy image scanning does not establish complete vulnerability coverage for the official Node.js binary"
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends ca-certificates libatomic1 \
    && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS dependencies
ARG NODE_VERSION
ADD --checksum=sha256:361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9 \
    https://nodejs.org/dist/v24.22.2/node-v24.22.2-linux-x64.tar.gz /tmp/node-v24.22.2-linux-x64.tar.gz
RUN mkdir -p /opt \
    && tar -xzf /tmp/node-v24.22.2-linux-x64.tar.gz -C /opt \
    && test -s /opt/node-v24.22.2-linux-x64/bin/node \
    && test -s /opt/node-v24.22.2-linux-x64/LICENSE \
    && rm -f /tmp/node-v24.22.2-linux-x64.tar.gz
ENV PATH="/opt/node-v24.22.2-linux-x64/bin:${PATH}"
WORKDIR /opt/browser
COPY package.json package-lock.json ./
RUN node --version | grep -Fx "v${NODE_VERSION}" \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && test -s node_modules/playwright-core/LICENSE

FROM runtime-base AS service-base
ARG NODE_VERSION
ARG SOURCE_REVISION
ARG PACKAGE_LOCK_SHA256
ENV PATH="/opt/node-v24/bin:${PATH}" \
    NODE_ENV=production \
    HOME=/tmp
WORKDIR /opt/browser
COPY package.json package-lock.json LICENSE NOTICE.md ./
COPY --from=dependencies /opt/node-v24.22.2-linux-x64/bin/node /opt/node-v24/bin/node
COPY --from=dependencies /opt/node-v24.22.2-linux-x64/LICENSE /usr/share/doc/nodejs/LICENSE
COPY --from=dependencies /opt/browser/node_modules ./node_modules
COPY --from=dependencies /opt/browser/node_modules/playwright-core/LICENSE /usr/share/doc/playwright-core/LICENSE
RUN node --version | grep -Fx "v${NODE_VERSION}" \
    && mkdir -p /run/browser-control /run/browser-egress /tmp/browser-sessions /opt/browser/src /opt/browser/fixture \
    && chown -R 10001:10001 /opt/browser /run/browser-control /run/browser-egress /tmp/browser-sessions \
    && chmod 0755 /opt/node-v24/bin/node
USER 10001:10001

FROM service-base AS proxy
LABEL io.404404.role="proxy"
COPY --chown=10001:10001 src/proxy.mjs src/policy.mjs src/errors.mjs ./src/
CMD ["node", "src/proxy.mjs"]

FROM service-base AS gateway
LABEL io.404404.role="gateway"
COPY --chown=10001:10001 src/gateway.mjs ./src/
CMD ["node", "src/gateway.mjs"]

FROM service-base AS fixture
LABEL io.404404.role="fixture"
COPY --chown=10001:10001 fixture/server.mjs ./fixture/
CMD ["node", "fixture/server.mjs"]

# Separate test client image; the gateway runtime remains free of the E2E harness.
FROM service-base AS e2e-runner
LABEL io.404404.role="e2e-runner"
COPY --chown=10001:10001 scripts/e2e.mjs ./scripts/
CMD ["node", "scripts/e2e.mjs"]
